# Base package price in INR (UI + Razorpay). Use 1 for live smoke tests, then set back to 999.
NEXT_PUBLIC_BASE_PRICE_INR=999

# Razorpay — Key ID is public-ish (sent to browser via create-order); Secret stays server-only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Google Apps Script web app URL (see docs/booking-setup.md)
BOOKING_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Instant ZIP signed downloads (see docs/r2-instant-downloads.md)
# Prefer Supabase S3_* if you do not want to add a card for Cloudflare R2.
# S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=finalyearkit-downloads
# Or Cloudflare R2 (usually requires a payment method even on free tier):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=finalyearkit-downloads

# Optional legacy booking fee (old /api/booking routes)
# NEXT_PUBLIC_BOOKING_FEE_INR=49

# Optional
# INDEXNOW_SECRET=
