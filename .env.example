# Booking fee in INR (UI + Razorpay amount). Redeploy after changing.
NEXT_PUBLIC_BOOKING_FEE_INR=49

# Razorpay — Key ID is public-ish (sent to browser via create-order); Secret stays server-only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Google Apps Script web app URL (see docs/booking-setup.md)
BOOKING_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Optional
# INDEXNOW_SECRET=
